"""Generate a simulated (synthetic) monthly healthcare service-usage dataset.

72 months (Jan 2019 - Dec 2024) of hospital admissions with:
  * a gradual upward trend (ageing population),
  * winter seasonality (respiratory season),
  * a temporary disruption in spring 2020,
  * random noise.
No real data is used."""
import numpy as np
import pandas as pd

rng = np.random.default_rng(7)
months = pd.date_range("2019-01-01", periods=72, freq="MS")
t = np.arange(72)

trend = 1000 + 4.2 * t                                   # +~50 admissions per year
season = 85 * np.cos(2 * np.pi * (months.month - 1) / 12)   # peak in Jan, trough in Jul
noise = rng.normal(0, 22, 72)
disruption = np.where((months >= "2020-03-01") & (months <= "2020-06-01"), -170, 0)

admissions = np.round(trend + season + noise + disruption).astype(int)
pct65 = np.round(24 + 0.055 * t + rng.normal(0, 0.15, 72), 2)       # % of admissions aged 65+
avg_los = np.round(5.3 + 0.004 * t + rng.normal(0, 0.12, 72), 2)    # average length of stay (days)

df = pd.DataFrame({
    "Month": months.strftime("%Y-%m"),
    "Admissions": admissions,
    "Pct_Aged_65_Plus": pct65,
    "Avg_Length_of_Stay": avg_los,
})
df.to_csv("data/monthly_admissions.csv", index=False)
print(f"Wrote data/monthly_admissions.csv with {len(df)} rows")
